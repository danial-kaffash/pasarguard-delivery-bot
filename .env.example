# ═══════════════════════════════════════════════════════════════
#  pasarguard-delivery-bot — copy to .env and fill in real values
# ═══════════════════════════════════════════════════════════════
#
#  Only these values are required in .env.
#  Everything else (panels, channels, trial settings) is managed
#  through the bot at runtime via /addpanel, /addchannel, etc.

# --- Telegram -------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# --- Owner (bootstrapped as superadmin on first run) ----------
OWNER_TG_IDS=12345678              # your Telegram user ID

# --- Encryption -----------------------------------------------
# Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty for no encryption (dev only — panel passwords stored in plaintext).
DB_ENCRYPTION_KEY=

# --- Database -------------------------------------------------
DB_PATH=data/bot.db

# --- Logging --------------------------------------------------
LOG_LEVEL=INFO
