# ═══════════════════════════════════════════════════════════════
#  pasarguard-greet-bot — copy to .env and fill in real values
# ═══════════════════════════════════════════════════════════════

# --- Telegram -------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
CHANNEL_ID=-1001234567890          # channel where the pinned promo post goes
PROMO_INTERVAL_HOURS=6             # runtime-changeable via /setinterval
PROMO_PIN=true
PROMO_SILENT=true                  # never ping subscribers

# --- PasarGuard panel ------------------------------------------
PANEL_BASE_URL=https://panelnet2.paqet.ir:8000
PANEL_ADMIN_USERNAME=greet-bot
PANEL_ADMIN_PASSWORD=change-me
PANEL_VERIFY_SSL=true              # set false if the panel uses a self-signed cert
PANEL_TIMEOUT_SECONDS=15

# --- Trial (on-hold mode) --------------------------------------
TRIAL_DATA_LIMIT_GB=5
TRIAL_DAYS=3                       # usage window after first connection
ON_HOLD_GRACE_DAYS=7               # must connect within this many days
TRIAL_PROTOCOLS=vless
OFFER_GROUPS_FILE=data/offer_groups.json
AUTO_DELETE_DAYS=11
ALLOW_REGRANT_AFTER_DAYS=30

# --- Owner / misc ----------------------------------------------
OWNER_TG_IDS=12345678,87654321     # comma-separated Telegram user IDs
DEFAULT_LANG=fa
DB_PATH=data/bot.db
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30            # per-user flood protection
